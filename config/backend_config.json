{
  "esp32": {
    "stream_url": "http://192.168.1.100:80/stream",
    "status_url": "http://192.168.1.100:80/status",
    "distance_url": "http://192.168.1.100:80/distance",
    "frame_url": "http://192.168.1.100:80/frame"
  },
  "network": {
    "backend_ip": "0.0.0.0",
    "backend_port": 5000
  },
  "alert_settings": {
    "critical_distance_cm": 50,
    "warning_distance_cm": 100
  },
  "modules": {
    "obstacle_detection": {
      "enabled": true,
      "always_on": true,
      "model": "yolo11n.pt",
      "confidence_threshold": 0.45
    },
    "depth_estimation": {
      "enabled": true,
      "model": "midas_small.onnx",
      "on_demand": false
    },
    "fall_detection": {
      "enabled": true,
      "interval_sec": 2.0,
      "alert_cooldown_sec": 10
    },
    "smart_prioritizer": {
      "enabled": true,
      "context_window_sec": 60,
      "announce_cooldown_sec": 12
    },
    "emotion_detection": {
      "enabled": true,
      "interval_sec": 2.0
    },
    "pose_estimation": {
      "enabled": true,
      "interval_sec": 1.5
    },
    "scene_description": {
      "enabled": true,
      "on_demand": true
    },
    "ocr_reading": {
      "enabled": true,
      "on_demand": true
    },
    "currency_detection": {
      "enabled": true,
      "on_demand": true
    },
    "navigation": {
      "enabled": true,
      "routing_api": "http://router.project-osrm.org",
      "turn_announce_distance_m": 15
    },
    "indoor_routes": {
      "enabled": true
    },
    "family_recognition": {
      "enabled": true,
      "interval_sec": 1.5,
      "confidence_threshold": 0.6,
      "cooldown_sec": 30
    },
    "gesture_recognition": {
      "enabled": true,
      "interval_sec": 0.5,
      "hold_duration_sec": 0.5
    },
    "system_monitor": {
      "enabled": true,
      "poll_interval_sec": 5
    },
    "sos": {
      "enabled": true,
      "webhook_url": "",
      "contacts": []
    }
  }
}